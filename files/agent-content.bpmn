<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_agent_content" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="dd55451" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ai-agent-content" name="Content &#38; Entertainment Agent" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_Content" name="Start">
      <bpmn:outgoing>Flow_start_to_agent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_agent" sourceRef="Start_Content" targetRef="Content_Agent" />
    <bpmn:adHocSubProcess id="Content_Agent" name="Content &#38; Entertainment Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id:      toolCall._meta.id,&#10;  name:    toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=providerConfig.type" target="provider.type" />
          <zeebe:input source="=providerConfig.region" target="provider.bedrock.region" />
          <zeebe:input source="=providerConfig.authType" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="=providerConfig.model" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;Role: You are a content and entertainment assistant. You help users find recipes and enjoy jokes using your tools.&#10;&#10;Boundaries: You can ONLY answer questions about recipes, food, cooking, and jokes/humour using your tools. If the user asks about something unrelated (user data, math, URLs, etc.), politely state that you specialise in content and entertainment.&#10;&#10;Priorities:&#10;1. If the user asks for a joke or something funny, call `Jokes API`.&#10;2. If the user asks about recipes, dishes, cooking, or ingredients, call `Search recipe` with a relevant keyword.&#10;3. You can call the same tool multiple times with different inputs to broaden results.&#10;&#10;Success criteria: The user receives relevant recipes or an entertaining joke sourced from the tools. Present results in a readable, engaging format.&#10;&#10;Thinking, step by step, before you execute your tools, you think using the template `&#60;thinking&#62;&#60;context&#62;&#60;/context&#62;&#60;reflection&#62;&#60;/reflection&#62;&#60;/thinking&#62;`&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput) and followUpInput != null) then followUpInput else inputText" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput) and followUpInput != null) then (if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []) else inputDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="=if (is defined(agentContext) and agentContext != null) then agentContext else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=20" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agent.context" target="agentContext" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_agent</bpmn:incoming>
      <bpmn:outgoing>Flow_agent_to_end</bpmn:outgoing>
      <bpmn:serviceTask id="Search_Recipe" name="Search recipe" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
        <bpmn:documentation>Use this tool when the user asks about recipes, dishes, cooking instructions, or ingredients. Pass a keyword or dish name as the search query (e.g. 'pasta', 'chicken tikka'). Returns matching recipes with ingredients and instructions, or 'No result found' if no match exists. Call multiple times with different queries to broaden results.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="https://dummyjson.com/recipes/search" target="url" />
            <zeebe:input source="={&#10;  q: fromAi(toolCall.searchQuery, &#34;The query describing which recipe to search (e.g. a specific dish or the cuisine).&#34;)&#10;}" target="queryParameters" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: if (count(response.body.recipes) &#62; 0) then response.body.recipes else &#34;No result found.&#34;&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Jokes_API" name="Jokes API" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
        <bpmn:documentation>Use this tool when the user asks for a joke, something funny, or entertainment. Takes no input parameters — returns a random joke each time. Safe-mode is enabled. Call once per joke request; call again if the user asks for another joke.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="https://v2.jokeapi.dev/joke/Any?format=txt&#38;safe-mode" target="url" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: response.body&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_agent_to_end" sourceRef="Content_Agent" targetRef="End_Content" />
    <bpmn:endEvent id="End_Content" name="Done">
      <bpmn:incoming>Flow_agent_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ai-agent-content">
      <bpmndi:BPMNShape id="Start_Content_di" bpmnElement="Start_Content">
        <dc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="158" y="238" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Content_Agent_di" bpmnElement="Content_Agent" isExpanded="true" bioc:stroke="#205022" bioc:fill="#e8f5e9" color:background-color="#e8f5e9" color:border-color="#205022">
        <dc:Bounds x="260" y="120" width="390" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Search_Recipe_di" bpmnElement="Search_Recipe" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="310" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Jokes_API_di" bpmnElement="Jokes_API" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="450" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Content_di" bpmnElement="End_Content">
        <dc:Bounds x="722" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="727" y="238" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_agent_di" bpmnElement="Flow_start_to_agent">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="260" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_agent_to_end_di" bpmnElement="Flow_agent_to_end">
        <di:waypoint x="650" y="220" />
        <di:waypoint x="722" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
