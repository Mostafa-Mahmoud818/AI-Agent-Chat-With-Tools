<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_agent_structured_response" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="8fb91b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ai-agent-structured-response" name="Structured Response Agent" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_Structured" name="Start">
      <bpmn:outgoing>Flow_start_to_agent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_agent" sourceRef="Start_Structured" targetRef="Structured_Agent" />
    <bpmn:adHocSubProcess id="Structured_Agent" name="Structured Response Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="us-east-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-3-5-haiku-20241022-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;Role: You are a Structured Response Analyst. Your sole purpose is to answer user queries by returning a valid JSON object that strictly conforms to the defined output schema. Never include any text, markdown, or code fences outside the JSON.&#34;&#10;+ &#34;&#10;&#10;Required JSON output schema — all five fields are mandatory in every response:&#10;- answer     : Direct and complete answer to the user query (string)&#10;- key_points : 3 to 5 concise takeaways from the answer (array of strings)&#10;- confidence : Confidence level in the answer  — one of: high, medium, low (string enum)&#10;- sentiment  : Overall tone of the topic       — one of: positive, neutral, negative (string enum)&#10;- category   : Short topic label such as science, history, technology, finance (string)&#34;&#10;+ &#34;&#10;&#10;Here is the exact JSON schema your output must conform to:&#10;{&#10;  \&#34;type\&#34;: \&#34;object\&#34;,&#10;  \&#34;required\&#34;: [\&#34;answer\&#34;, \&#34;key_points\&#34;, \&#34;confidence\&#34;, \&#34;sentiment\&#34;, \&#34;category\&#34;],&#10;  \&#34;properties\&#34;: {&#10;    \&#34;answer\&#34;:     { \&#34;type\&#34;: \&#34;string\&#34;, \&#34;description\&#34;: \&#34;Direct answer to the user query\&#34; },&#10;    \&#34;key_points\&#34;: { \&#34;type\&#34;: \&#34;array\&#34;, \&#34;items\&#34;: { \&#34;type\&#34;: \&#34;string\&#34; }, \&#34;minItems\&#34;: 1, \&#34;maxItems\&#34;: 5, \&#34;description\&#34;: \&#34;3 to 5 concise takeaways\&#34; },&#10;    \&#34;confidence\&#34;: { \&#34;type\&#34;: \&#34;string\&#34;, \&#34;enum\&#34;: [\&#34;high\&#34;, \&#34;medium\&#34;, \&#34;low\&#34;], \&#34;description\&#34;: \&#34;Confidence level in the answer\&#34; },&#10;    \&#34;sentiment\&#34;:  { \&#34;type\&#34;: \&#34;string\&#34;, \&#34;enum\&#34;: [\&#34;positive\&#34;, \&#34;neutral\&#34;, \&#34;negative\&#34;], \&#34;description\&#34;: \&#34;Overall tone of the topic\&#34; },&#10;    \&#34;category\&#34;:   { \&#34;type\&#34;: \&#34;string\&#34;, \&#34;description\&#34;: \&#34;Short topic category label\&#34; }&#10;  }&#10;}&#34;&#10;+ &#34;&#10;&#10;Available tools — use them when the query requires it:&#10;- Get Current Date  : Returns the current ISO 8601 date-time. Use for any date, time, or day-of-week query — never guess.&#10;- Compute Text Stats: Returns wordCount and charCount for supplied text. Use when asked for word or character counts.&#34;&#10;+ &#34;&#10;&#10;Rules:&#10;1. Respond with ONLY the raw JSON object — no preamble, no explanation, no markdown fences.&#10;2. All five schema fields (answer, key_points, confidence, sentiment, category) must be present.&#10;3. Do NOT use &#60;thinking&#62; tags.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=(if (is defined(conversationHistory) and conversationHistory != null and count(conversationHistory) &#62; 0) then &#34;[Prior session context:&#10;&#34; + string join(for e in conversationHistory return string(e), &#34;&#10;&#34;) + &#34;]&#10;&#10;&#34; else &#34;&#34;) + currentInput" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(inputDocuments) and inputDocuments != null) then inputDocuments else []" target="data.userPrompt.documents" />
          <zeebe:input source="=if (is defined(agentContext) and agentContext != null) then agentContext else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=9999" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_agent</bpmn:incoming>
      <bpmn:outgoing>Flow_agent_to_end</bpmn:outgoing>
      <bpmn:scriptTask id="GetCurrentDate" name="Get Current Date">
        <bpmn:documentation>Call this tool when the user query involves the current date, time, day of the week, or any temporal reference. Takes no input parameters. Returns the current ISO 8601 date-time with timezone offset. Always use this tool for time-related queries — never guess.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=now()" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="ComputeTextStats" name="Compute Text Stats">
        <bpmn:documentation>Call this tool when the user asks for numeric analysis of text — such as word count, character count, or sentence count. Requires one string input: 'text' (the text to analyse). Returns a context with wordCount and charCount fields.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="={wordCount: count(split(string(inputText), &#34; &#34;)), charCount: string length(string(inputText))}" resultVariable="toolCallResult" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.text, &#34;The text to analyse for word count and character count.&#34;)" target="inputText" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_agent_to_end" sourceRef="Structured_Agent" targetRef="End_Structured" />
    <bpmn:endEvent id="End_Structured" name="Done">
      <bpmn:incoming>Flow_agent_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ai-agent-structured-response">
      <bpmndi:BPMNShape id="Start_Structured_di" bpmnElement="Start_Structured">
        <dc:Bounds x="152" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="223" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Structured_Agent_di" bpmnElement="Structured_Agent" isExpanded="true" bioc:stroke="#e65100" bioc:fill="#fff3e0" color:background-color="#fff3e0" color:border-color="#e65100">
        <dc:Bounds x="260" y="100" width="530" height="210" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GetCurrentDate_di" bpmnElement="GetCurrentDate" bioc:stroke="#e65100" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#e65100">
        <dc:Bounds x="300" y="155" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ComputeTextStats_di" bpmnElement="ComputeTextStats" bioc:stroke="#e65100" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#e65100">
        <dc:Bounds x="440" y="155" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Structured_di" bpmnElement="End_Structured">
        <dc:Bounds x="852" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="857" y="223" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_agent_di" bpmnElement="Flow_start_to_agent">
        <di:waypoint x="188" y="205" />
        <di:waypoint x="260" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_agent_to_end_di" bpmnElement="Flow_agent_to_end">
        <di:waypoint x="790" y="205" />
        <di:waypoint x="852" y="205" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>