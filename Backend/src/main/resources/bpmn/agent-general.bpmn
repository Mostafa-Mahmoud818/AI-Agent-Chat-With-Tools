<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_agent_general" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="8fb91b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ai-agent-general" name="General Agent" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_General" name="Start">
      <bpmn:outgoing>Flow_start_to_agent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_agent" sourceRef="Start_General" targetRef="General_Agent" />
    <bpmn:adHocSubProcess id="General_Agent" name="General Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id:      toolCall._meta.id,&#10;  name:    toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=providerConfig.region" target="provider.bedrock.region" />
          <zeebe:input source="=providerConfig.authType" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="=providerConfig.model" target="provider.bedrock.model.model" />
          <zeebe:input source="=providerConfig.type" target="provider.type" />
          <zeebe:input source="=&#34;Role: You are a knowledgeable general assistant. You answer any question directly using your own training data. You have no useful external tools — the &#39;Knowledge Answer&#39; tool is a system placeholder only; do not call it under any circumstances.&#10;&#10;Boundaries: You handle math, arithmetic, science, history, geography, coding, explanations, definitions, comparisons, creative writing, language translation, trivia, advice, and every other general knowledge topic. Do NOT mention other agents, tools, or systems. You are self-sufficient.&#10;&#10;Priorities:&#10;1. Always provide the answer immediately in your first response.&#10;2. For math: compute the result and state it clearly (e.g., 3 * 5 = 15).&#10;3. Be concise — answer first, then add brief context only if it adds value.&#10;&#10;Success criteria: The user receives a direct, accurate answer without deflection or unnecessary caveats. If you genuinely do not know something, say so briefly and suggest what the user could search for. Do NOT use &#60;thinking&#62; tags — write your full answer directly.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=(if (is defined(conversationHistory) and conversationHistory != null and count(conversationHistory) > 0) then &quot;[Prior session context:&#10;&quot; + string join(for e in conversationHistory return string(e), &quot;&#10;&quot;) + &quot;]&#10;&#10;&quot; else &quot;&quot;) + currentInput" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(inputDocuments) and inputDocuments != null) then inputDocuments else []" target="data.userPrompt.documents" />
          <zeebe:input source="=if (is defined(agentContext) and agentContext != null) then agentContext else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=9999" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent.context" target="agentContext" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_agent</bpmn:incoming>
      <bpmn:outgoing>Flow_agent_to_end</bpmn:outgoing>
      <bpmn:scriptTask id="KnowledgeAnswer" name="Knowledge Answer">
        <bpmn:documentation>This is a placeholder tool required by the ad-hoc subprocess. The General Agent answers all questions from its own knowledge and does not need to call any tools. Do not use this tool.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=&#34;No tool call needed. Answer from your own knowledge.&#34;" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_agent_to_end" sourceRef="General_Agent" targetRef="End_General" />
    <bpmn:endEvent id="End_General" name="Done">
      <bpmn:incoming>Flow_agent_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ai-agent-general">
      <bpmndi:BPMNShape id="Start_General_di" bpmnElement="Start_General">
        <dc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="158" y="238" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="General_Agent_di" bpmnElement="General_Agent" isExpanded="true" bioc:stroke="#424242" bioc:fill="#f5f5f5" color:background-color="#f5f5f5" color:border-color="#424242">
        <dc:Bounds x="260" y="120" width="440" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="KnowledgeAnswer_di" bpmnElement="KnowledgeAnswer" bioc:stroke="#424242" bioc:fill="#e0e0e0" color:background-color="#e0e0e0" color:border-color="#424242">
        <dc:Bounds x="310" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_General_di" bpmnElement="End_General">
        <dc:Bounds x="762" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="767" y="238" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_agent_di" bpmnElement="Flow_start_to_agent">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="260" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_agent_to_end_di" bpmnElement="Flow_agent_to_end">
        <di:waypoint x="700" y="220" />
        <di:waypoint x="762" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
