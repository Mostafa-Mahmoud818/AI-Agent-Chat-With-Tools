<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_main_router" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="8fb91b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ai-agent-chat-router" name="AI Agent Chat Router (Main)" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="2.1" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_ChatSessionStarted" name="Chat session started">
      <bpmn:outgoing>Flow_start_to_config</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Start" messageRef="Message_ChatStart" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_config" sourceRef="StartEvent_ChatSessionStarted" targetRef="Gateway_StartOrContinue" />
    <bpmn:exclusiveGateway id="Gateway_StartOrContinue" name="Start / continue">
      <bpmn:incoming>Flow_start_to_config</bpmn:incoming>
      <bpmn:incoming>Flow_from_reply</bpmn:incoming>
      <bpmn:outgoing>Flow_config_to_task</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_config_to_task" sourceRef="Gateway_StartOrContinue" targetRef="SetProviderConfig" />
    <bpmn:scriptTask id="SetProviderConfig" name="Set Provider Config">
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  providerConfig: {&#10;    type:     &#34;bedrock&#34;,&#10;    region:   &#34;us-east-1&#34;,&#10;    authType: &#34;credentials&#34;,&#10;    model:    &#34;us.anthropic.claude-3-5-haiku-20241022-v1:0&#34;&#10;  },&#10;  currentInput: if (is defined(followUpInput) and followUpInput != null) then followUpInput else inputText&#10;}" resultVariable="turnSetup" />
        <zeebe:ioMapping>
          <zeebe:output source="=turnSetup.providerConfig" target="providerConfig" />
          <zeebe:output source="=turnSetup.currentInput" target="currentInput" />
          <zeebe:output source="=null" target="agent" />
          <zeebe:output source="=null" target="routeCategory" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_config_to_task</bpmn:incoming>
      <bpmn:outgoing>Flow_to_classifier</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_to_classifier" sourceRef="SetProviderConfig" targetRef="ClassifyRequestIntent" />
    <bpmn:serviceTask id="ClassifyRequestIntent" name="Classify Request Intent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>AI-powered intent classifier. Analyses the user request and returns routeCategory as one of: user_data, utility, general.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=providerConfig.region" target="provider.bedrock.region" />
          <zeebe:input source="=providerConfig.authType" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="=providerConfig.model" target="provider.bedrock.model.model" />
          <zeebe:input source="=providerConfig.type" target="provider.type" />
          <zeebe:input source="=&#34;## Role&#10;You are a request intent classifier. Your only task is to output exactly one category label. You must not answer the user&#39;s question, explain, or add any other text.&#10;&#10;## Output format&#10;Respond with exactly one of these tokens: user_data | utility | general&#10;&#10;## Category definitions&#10;- user_data: Requests about users, people, contacts, profiles, emails, phones, accounts, members, customers, or listing/loading user records.&#10;- utility: Current date, time, or timezone; superflux product (3*(a+b)); fetching or opening a specific URL/website.&#10;- general: Everything else — math (non-superflux), science, history, geography, coding, explanations, definitions, creative writing, translation, trivia, advice, or ambiguous requests.&#10;&#10;## Rules&#10;1. Output only the single category word. No punctuation, no explanation.&#10;2. If the request fits multiple categories, choose the single most specific match. If truly ambiguous, default to general.&#10;3. For short follow-ups (e.g. &#39;yes&#39;, &#39;no&#39;, &#39;more&#39;, &#39;another one&#39;, &#39;ok&#39;, &#39;sure&#39;, &#39;continue&#39;, &#39;thanks&#39;), reuse the same category as the previous turn.&#10;4. Do not use &#60;thinking&#62; or any tags. Output only: user_data, utility, or general.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=currentInput" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(classifierAgentCtx) and classifierAgentCtx != null) then classifierAgentCtx else null" target="data.context" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=5" target="data.memory.contextWindowSize" />
          <zeebe:input source="=9999" target="data.limits.maxModelCalls" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:output source="=lower case(trim(classifierResult.responseText))" target="routeCategory" />
          <zeebe:output source="=classifierResult.context" target="classifierAgentCtx" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.v1" />
          <zeebe:header key="resultVariable" value="classifierResult" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_classifier</bpmn:incoming>
      <bpmn:outgoing>Flow_to_route</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_to_route" sourceRef="ClassifyRequestIntent" targetRef="Gateway_RouteByCategory" />
    <bpmn:exclusiveGateway id="Gateway_RouteByCategory" name="Route by category" default="Flow_to_general">
      <bpmn:incoming>Flow_to_route</bpmn:incoming>
      <bpmn:outgoing>Flow_to_user_data</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_utility</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_general</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_to_user_data" name="user_data" sourceRef="Gateway_RouteByCategory" targetRef="Call_UserData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routeCategory = "user_data"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_utility" name="utility" sourceRef="Gateway_RouteByCategory" targetRef="Call_Utility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routeCategory = "utility"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_general" name="general" sourceRef="Gateway_RouteByCategory" targetRef="Call_General" />
    <bpmn:callActivity id="Call_UserData" name="User Data Agent">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="ai-agent-user-data" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=currentInput" target="currentInput" />
          <zeebe:input source="=if (is defined(conversationHistory) and conversationHistory != null) then conversationHistory else null" target="conversationHistory" />
          <zeebe:input source="=if (is defined(inputDocuments) and inputDocuments != null) then inputDocuments else []" target="inputDocuments" />
          <zeebe:input source="=if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []" target="followUpDocuments" />
          <zeebe:input source="=if (is defined(userDataAgentCtx) and userDataAgentCtx != null) then userDataAgentCtx else null" target="agentContext" />
          <zeebe:input source="=providerConfig" target="providerConfig" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agentContext" target="userDataAgentCtx" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_user_data</bpmn:incoming>
      <bpmn:outgoing>Flow_ud_to_merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Utility" name="Utility &#38; Web Agent">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="ai-agent-utility" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=currentInput" target="currentInput" />
          <zeebe:input source="=if (is defined(conversationHistory) and conversationHistory != null) then conversationHistory else null" target="conversationHistory" />
          <zeebe:input source="=if (is defined(inputDocuments) and inputDocuments != null) then inputDocuments else []" target="inputDocuments" />
          <zeebe:input source="=if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []" target="followUpDocuments" />
          <zeebe:input source="=if (is defined(utilityAgentCtx) and utilityAgentCtx != null) then utilityAgentCtx else null" target="agentContext" />
          <zeebe:input source="=providerConfig" target="providerConfig" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agentContext" target="utilityAgentCtx" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_utility</bpmn:incoming>
      <bpmn:outgoing>Flow_ut_to_merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_General" name="General Agent">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="ai-agent-general" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=currentInput" target="currentInput" />
          <zeebe:input source="=if (is defined(conversationHistory) and conversationHistory != null) then conversationHistory else null" target="conversationHistory" />
          <zeebe:input source="=if (is defined(inputDocuments) and inputDocuments != null) then inputDocuments else []" target="inputDocuments" />
          <zeebe:input source="=if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []" target="followUpDocuments" />
          <zeebe:input source="=if (is defined(generalAgentCtx) and generalAgentCtx != null) then generalAgentCtx else null" target="agentContext" />
          <zeebe:input source="=providerConfig" target="providerConfig" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agentContext" target="generalAgentCtx" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_general</bpmn:incoming>
      <bpmn:outgoing>Flow_gn_to_merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Error_UserData" name="Agent error" attachedToRef="Call_UserData">
      <bpmn:outgoing>Flow_err_ud</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_UserData" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_Utility" name="Agent error" attachedToRef="Call_Utility">
      <bpmn:outgoing>Flow_err_ut</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Utility" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_General" name="Agent error" attachedToRef="Call_General">
      <bpmn:outgoing>Flow_err_gn</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_General" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_err_ud" sourceRef="Error_UserData" targetRef="Gateway_MergeErrors" />
    <bpmn:sequenceFlow id="Flow_err_ut" sourceRef="Error_Utility" targetRef="Gateway_MergeErrors" />
    <bpmn:sequenceFlow id="Flow_err_gn" sourceRef="Error_General" targetRef="Gateway_MergeErrors" />
    <bpmn:exclusiveGateway id="Gateway_MergeErrors" name="Merge errors">
      <bpmn:incoming>Flow_err_ud</bpmn:incoming>
      <bpmn:incoming>Flow_err_ut</bpmn:incoming>
      <bpmn:incoming>Flow_err_gn</bpmn:incoming>
      <bpmn:outgoing>Flow_errors_to_handler</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_errors_to_handler" sourceRef="Gateway_MergeErrors" targetRef="HandleAgentError" />
    <bpmn:scriptTask id="HandleAgentError" name="Handle Agent Error">
      <bpmn:documentation>Sets a user-friendly error response when an agent subprocess fails.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="={responseText: &#34;I encountered an error while processing your request. Please try rephrasing your question or starting a new chat.&#34;, context: null}" resultVariable="agentErrorResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=agentErrorResult" target="agent" />
          <zeebe:output source="=&#34;error&#34;" target="routeCategory" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_errors_to_handler</bpmn:incoming>
      <bpmn:outgoing>Flow_error_to_merge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ud_to_merge" sourceRef="Call_UserData" targetRef="Gateway_MergeResults" />
    <bpmn:sequenceFlow id="Flow_ut_to_merge" sourceRef="Call_Utility" targetRef="Gateway_MergeResults" />
    <bpmn:sequenceFlow id="Flow_gn_to_merge" sourceRef="Call_General" targetRef="Gateway_MergeResults" />
    <bpmn:sequenceFlow id="Flow_error_to_merge" sourceRef="HandleAgentError" targetRef="Gateway_MergeResults" />
    <bpmn:exclusiveGateway id="Gateway_MergeResults" name="Merge results">
      <bpmn:incoming>Flow_ud_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_ut_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_gn_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_error_to_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_to_history</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_merge_to_history" sourceRef="Gateway_MergeResults" targetRef="StoreConversationHistory" />
    <bpmn:scriptTask id="StoreConversationHistory" name="Store Conversation History">
      <bpmn:documentation>Appends the current turn (user message + agent response) to conversationHistory, keeping the last 6 entries (3 exchanges). This cross-agent history is passed to every agent so they have full session awareness.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  h: if (is defined(conversationHistory) and conversationHistory != null) then conversationHistory else [],&#10;  d: if (agent != null and is defined(agent.responseText) and agent.responseText != null) then string(agent.responseText) else &#34;&#34;,&#10;  tm: if (agent != null and is defined(agent.conversation) and agent.conversation != null and is defined(agent.conversation.messages)) then agent.conversation.messages[role = &#34;tool_call_result&#34;] else [],&#10;  tr: if (count(tm) &#62; 0 and is defined(tm[count(tm)].results) and count(tm[count(tm)].results) &#62; 0 and is defined(tm[count(tm)].results[1].content)) then string(tm[count(tm)].results[1].content) else &#34;&#34;,&#10;  rt: if (d != &#34;&#34;) then d else tr,&#10;  t: if (string-length(rt) &#62; 200) then substring(rt, 1, 200) + &#34;...&#34; else rt,&#10;  e: &#34;User: &#34; + currentInput + &#34; | &#34; + string(routeCategory) + &#34; agent: &#34; + t,&#10;  u: h + [e],&#10;  r: if (count(u) &#62; 6) then sublist(u, count(u) - 5) else u&#10;}.r" resultVariable="conversationHistory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_merge_to_history</bpmn:incoming>
      <bpmn:outgoing>Flow_history_to_wait</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_history_to_wait" sourceRef="StoreConversationHistory" targetRef="EventGateway_Wait" />
    <bpmn:eventBasedGateway id="EventGateway_Wait" name="Wait for user or timeout">
      <bpmn:incoming>Flow_history_to_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_to_msg</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_to_msg" sourceRef="EventGateway_Wait" targetRef="MessageCatchEvent_UserReply" />
    <bpmn:sequenceFlow id="Flow_to_timer" sourceRef="EventGateway_Wait" targetRef="TimerEvent_Timeout" />
    <bpmn:intermediateCatchEvent id="MessageCatchEvent_UserReply" name="User sends next message">
      <bpmn:incoming>Flow_to_msg</bpmn:incoming>
      <bpmn:outgoing>Flow_from_reply</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Reply" messageRef="Message_UserReply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TimerEvent_Timeout" name="30 min inactivity">
      <bpmn:incoming>Flow_to_timer</bpmn:incoming>
      <bpmn:outgoing>Flow_timeout_end</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_from_reply" sourceRef="MessageCatchEvent_UserReply" targetRef="Gateway_StartOrContinue" />
    <bpmn:sequenceFlow id="Flow_timeout_end" sourceRef="TimerEvent_Timeout" targetRef="EndEvent_Timeout" />
    <bpmn:endEvent id="EndEvent_Timeout" name="Session ended (inactivity)">
      <bpmn:incoming>Flow_timeout_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_ChatStart" name="ai-chat-start" />
  <bpmn:message id="Message_UserReply" name="ai-chat-user-reply">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=sessionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ai-agent-chat-router">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent_ChatSessionStarted">
        <dc:Bounds x="-8" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-21" y="385" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_StartOrContinue_di" bpmnElement="Gateway_StartOrContinue" isMarkerVisible="true">
        <dc:Bounds x="80" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="68" y="392" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SetProviderConfig_di" bpmnElement="SetProviderConfig" bioc:stroke="#e65100" bioc:fill="#fff3e0" color:background-color="#fff3e0" color:border-color="#e65100">
        <dc:Bounds x="200" y="320" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClassifyRequestIntent_di" bpmnElement="ClassifyRequestIntent" bioc:stroke="#e65100" bioc:fill="#fff3e0" color:background-color="#fff3e0" color:border-color="#e65100">
        <dc:Bounds x="370" y="320" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_RouteByCategory_di" bpmnElement="Gateway_RouteByCategory" isMarkerVisible="true">
        <dc:Bounds x="595" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="515" y="323" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_UserData_di" bpmnElement="Call_UserData" bioc:stroke="#0d4372" bioc:fill="#e3f2fd" color:background-color="#e3f2fd" color:border-color="#0d4372">
        <dc:Bounds x="760" y="80" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Utility_di" bpmnElement="Call_Utility" bioc:stroke="#4a148c" bioc:fill="#f3e5f5" color:background-color="#f3e5f5" color:border-color="#4a148c">
        <dc:Bounds x="760" y="360" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_General_di" bpmnElement="Call_General" bioc:stroke="#424242" bioc:fill="#f5f5f5" color:background-color="#f5f5f5" color:border-color="#424242">
        <dc:Bounds x="760" y="500" width="200" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_MergeErrors_di" bpmnElement="Gateway_MergeErrors" isMarkerVisible="true" bioc:stroke="#b71c1c" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#b71c1c">
        <dc:Bounds x="1055" y="635" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1045" y="692" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandleAgentError_di" bpmnElement="HandleAgentError" bioc:stroke="#b71c1c" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#b71c1c">
        <dc:Bounds x="1260" y="620" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_MergeResults_di" bpmnElement="Gateway_MergeResults" isMarkerVisible="true">
        <dc:Bounds x="1285" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1325" y="323" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StoreConversationHistory_di" bpmnElement="StoreConversationHistory">
        <dc:Bounds x="1350" y="320" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EventGateway_Wait_di" bpmnElement="EventGateway_Wait">
        <dc:Bounds x="1510" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1570" y="346" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Msg_UserReply_di" bpmnElement="MessageCatchEvent_UserReply" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
