<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_agent_utility" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="8fb91b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ai-agent-utility" name="Utility &#38; Web Agent" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_Utility" name="Start">
      <bpmn:outgoing>Flow_start_to_agent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_agent" sourceRef="Start_Utility" targetRef="Utility_Agent" />
    <bpmn:adHocSubProcess id="Utility_Agent" name="Utility &#38; Web Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id:      toolCall._meta.id,&#10;  name:    toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=providerConfig.region" target="provider.bedrock.region" />
          <zeebe:input source="=providerConfig.authType" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="=providerConfig.model" target="provider.bedrock.model.model" />
          <zeebe:input source="=providerConfig.type" target="provider.type" />
          <zeebe:input source="=&#34;## Role&#10;You are a Utility and Web Assistant. You answer only by using your tools: current date/time, superflux product calculation, and URL fetching. You must not answer from memory when a tool applies.&#10;&#10;## Scope&#10;- In scope: current date, time, or timezone; superflux product (formula: 3 * (a + b)) given two numbers; fetching content from a user-provided HTTP/HTTPS URL.&#10;- Out of scope: user data, general knowledge, or any question that does not require one of your tools. Politely decline and suggest the user rephrase or use the main chat.&#10;&#10;## Tool use (mandatory when applicable)&#10;1. Get Date and Time — Use for any request about current date, time, day, or timezone. Never guess or infer; always call this tool.&#10;2. Superflux Product Calculation — Use when the user asks for a superflux product or to compute 3*(a+b). Extract two numbers (a, b) from the request and call the tool. Never compute manually.&#10;3. Fetch URL — Use when the user asks to fetch, retrieve, or open a specific URL. Use the exact HTTP/HTTPS URL provided. Report errors (e.g. unreachable, timeout) clearly to the user.&#10;&#10;## Output rules&#10;- Present tool results clearly (e.g. date/time in a readable format; superflux result as the numeric answer; URL content summarised or quoted as appropriate).&#10;- Do not use &#60;thinking&#62; or any XML/reasoning tags.&#10;&#10;## Boundaries&#10;If the request does not match any tool (e.g. no URL given, or topic is general knowledge), respond: &#39;I can only help with current date/time, superflux calculations, or fetching a URL. Please ask one of those.&#39;&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=(if (is defined(conversationHistory) and conversationHistory != null and count(conversationHistory) &#62; 0) then &quot;[Prior session context:&#10;&quot; + string join(for e in conversationHistory return string(e), &quot;&#10;&quot;) + &quot;]&#10;&#10;&quot; else &quot;&quot;) + currentInput" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(inputDocuments) and inputDocuments != null) then inputDocuments else []" target="data.userPrompt.documents" />
          <zeebe:input source="=if (is defined(agentContext) and agentContext != null) then agentContext else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=9999" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent.context" target="agentContext" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_agent</bpmn:incoming>
      <bpmn:outgoing>Flow_agent_to_end</bpmn:outgoing>
      <bpmn:scriptTask id="GetDateAndTime" name="Get Date and Time">
        <bpmn:documentation>Use this tool when the user asks for the current date, time, day of week, or 'what time is it'. Takes no parameters. Returns an ISO 8601 date-time with timezone. Do not guess the time — always call this tool.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=now()" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="SuperfluxProduct" name="Superflux Product Calculation">
        <bpmn:documentation>Use this tool when the user asks to calculate a superflux product. Requires exactly two numeric inputs: 'a' (first number) and 'b' (second number). Computes the formula 3 * (a + b). Do not attempt this calculation manually — always use this tool.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=3 * (inputA + inputB)" resultVariable="toolCallResult" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.a, &#34;The first number to be superflux calculated.&#34;, &#34;number&#34;)" target="inputA" />
            <zeebe:input source="=fromAi(toolCall.b, &#34;The second number to be superflux calculated.&#34;, &#34;number&#34;)" target="inputB" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Fetch_URL" name="Fetch URL" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
        <bpmn:documentation>Use this tool when the user asks to fetch, retrieve, or open a URL. Requires a fully-qualified HTTP or HTTPS URL (e.g. 'https://example.com'). Returns the response body content. Do not use for non-HTTP protocols. If the URL is malformed or unreachable, the tool will return an error — report this to the user.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=fromAi(toolCall.url, &#34;The URL to fetch&#34;)" target="url" />
            <zeebe:input source="=true" target="storeResponse" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: response.document&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_agent_to_end" sourceRef="Utility_Agent" targetRef="End_Utility" />
    <bpmn:endEvent id="End_Utility" name="Done">
      <bpmn:incoming>Flow_agent_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ai-agent-utility">
      <bpmndi:BPMNShape id="Start_Utility_di" bpmnElement="Start_Utility">
        <dc:Bounds x="152" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="223" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Utility_Agent_di" bpmnElement="Utility_Agent" isExpanded="true" bioc:stroke="#4a148c" bioc:fill="#f3e5f5" color:background-color="#f3e5f5" color:border-color="#4a148c">
        <dc:Bounds x="260" y="100" width="680" height="210" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GetDateAndTime_di" bpmnElement="GetDateAndTime" bioc:stroke="#4a148c" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#4a148c">
        <dc:Bounds x="300" y="155" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SuperfluxProduct_di" bpmnElement="SuperfluxProduct" bioc:stroke="#4a148c" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#4a148c">
        <dc:Bounds x="440" y="155" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fetch_URL_di" bpmnElement="Fetch_URL" bioc:stroke="#4a148c" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#4a148c">
        <dc:Bounds x="580" y="155" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Utility_di" bpmnElement="End_Utility">
        <dc:Bounds x="1012" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1017" y="223" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_agent_di" bpmnElement="Flow_start_to_agent">
        <di:waypoint x="188" y="205" />
        <di:waypoint x="260" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_agent_to_end_di" bpmnElement="Flow_agent_to_end">
        <di:waypoint x="940" y="205" />
        <di:waypoint x="1012" y="205" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
