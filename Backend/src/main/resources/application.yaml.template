# Copy this file to application.yaml and fill in your values.
# application.yaml is gitignored — never commit real credentials.
#
# Required environment variables (or set values directly here for local dev only):
#   CAMUNDA_CLIENT_ID         - OAuth client ID from Camunda Console
#   CAMUNDA_CLIENT_SECRET     - OAuth client secret from Camunda Console
#   CAMUNDA_CLIENT_CLOUD_CLUSTERID - Your cluster ID (e.g. 6bab2a8e-...)
#   CAMUNDA_CLIENT_CLOUD_REGION    - Your cluster region (e.g. ric-1)

camunda:
  client:
    mode: saas
    auth:
      client-id: ${CAMUNDA_CLIENT_ID}
      client-secret: ${CAMUNDA_CLIENT_SECRET}
      token-url: https://login.cloud.camunda.io/oauth/token
    grpc-address: grpcs://${camunda.client.cloud.cluster-id}.${camunda.client.cloud.region}.zeebe.camunda.io:443
    rest-address: https://${camunda.client.cloud.region}.zeebe.camunda.io/${camunda.client.cloud.cluster-id}
    cloud:
      cluster-id: ${CAMUNDA_CLIENT_CLOUD_CLUSTERID}
      region: ${CAMUNDA_CLIENT_CLOUD_REGION}

server:
  port: 8081

app:
  cors:
    allowed-origins: http://localhost:5173,http://127.0.0.1:5173
  camunda:
    cluster-api-url: https://${camunda.client.cloud.region}.zeebe.camunda.io/${camunda.client.cloud.cluster-id}
    process-id: ai-agent-chat-with-tools

logging:
  level:
    com.example.aichat: DEBUG
    io.camunda: INFO
