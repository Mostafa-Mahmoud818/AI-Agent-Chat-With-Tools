      <bpmndi:BPMNEdge id="Assoc_start_di" bpmnElement="Assoc_start">
        <di:waypoint x="279" y="457" />
        <di:waypoint x="276" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_response_di" bpmnElement="Assoc_response">
        <di:waypoint x="1247" y="467" />
        <di:waypoint x="1390" y="398" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_086jrt4_di" bpmnElement="Association_086jrt4">
        <di:waypoint x="1340" y="203" />
