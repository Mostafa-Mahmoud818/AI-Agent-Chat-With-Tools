<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_18jxukq" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="9b0b274" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="ai-agent-chat-with-tools" name="AI Agent Chat With Tools" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="3.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_ChatSessionStarted" name="Chat session started">
      <bpmn:outgoing>Flow_start_to_gw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Start" messageRef="Message_ChatStart" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_gw" sourceRef="StartEvent_ChatSessionStarted" targetRef="Gateway_StartOrContinue" />
    <bpmn:exclusiveGateway id="Gateway_StartOrContinue" name="Start / continue">
      <bpmn:incoming>Flow_start_to_gw</bpmn:incoming>
      <bpmn:incoming>Flow_from_reply</bpmn:incoming>
      <bpmn:outgoing>Flow_to_classifier</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_to_classifier" sourceRef="Gateway_StartOrContinue" targetRef="ClassifyRequest" />
    <bpmn:scriptTask id="ClassifyRequest" name="Classify Request">
      <bpmn:documentation>Classifies the user request into a category (user_data, content, utility, general) for routing to the appropriate specialized agent.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=replace(replace(lower case(if (is defined(followUpInput) and followUpInput != null) then followUpInput else (if (is defined(inputText) and inputText != null) then inputText else &#34;&#34;)), &#34;[^a-z0-9 ]&#34;, &#34; &#34;), &#34;\s+&#34;, &#34; &#34;)" target="currentInput" />
          <zeebe:output source="=routeCategory" target="routeCategory" />
        </zeebe:ioMapping>
        <zeebe:script expression="=if (some kw in [&#34;user&#34;,&#34;users&#34;,&#34;person&#34;,&#34;contact&#34;,&#34;people&#34;,&#34;email&#34;,&#34;phone&#34;,&#34;member&#34;,&#34;customer&#34;,&#34;profile&#34;,&#34;account&#34;] satisfies contains(&#34; &#34; + currentInput + &#34; &#34;, &#34; &#34; + kw + &#34; &#34;)) then &#34;user_data&#34; else if (some kw in [&#34;recipe&#34;,&#34;cook&#34;,&#34;dish&#34;,&#34;cuisine&#34;,&#34;joke&#34;,&#34;funny&#34;,&#34;humor&#34;,&#34;laugh&#34;,&#34;food&#34;,&#34;meal&#34;,&#34;ingredient&#34;] satisfies contains(&#34; &#34; + currentInput + &#34; &#34;, &#34; &#34; + kw + &#34; &#34;)) then &#34;content&#34; else if (some kw in [&#34;time&#34;,&#34;date&#34;,&#34;clock&#34;,&#34;calculate&#34;,&#34;superflux&#34;,&#34;math&#34;,&#34;url&#34;,&#34;fetch&#34;,&#34;http&#34;,&#34;website&#34;,&#34;now&#34;,&#34;today&#34;,&#34;convert&#34;] satisfies contains(&#34; &#34; + currentInput + &#34; &#34;, &#34; &#34; + kw + &#34; &#34;)) then &#34;utility&#34; else &#34;general&#34;" resultVariable="routeCategory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_classifier</bpmn:incoming>
      <bpmn:outgoing>Flow_to_route</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_to_route" sourceRef="ClassifyRequest" targetRef="Gateway_RouteByCategory" />
    <bpmn:exclusiveGateway id="Gateway_RouteByCategory" name="Route by category" default="Flow_to_general">
      <bpmn:incoming>Flow_to_route</bpmn:incoming>
      <bpmn:outgoing>Flow_to_user_data</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_content</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_utility</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_general</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_to_user_data" name="user_data" sourceRef="Gateway_RouteByCategory" targetRef="UserData_Agent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routeCategory = "user_data"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_content" name="content" sourceRef="Gateway_RouteByCategory" targetRef="Content_Agent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routeCategory = "content"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_utility" name="utility" sourceRef="Gateway_RouteByCategory" targetRef="Utility_Agent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routeCategory = "utility"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_to_general" name="general" sourceRef="Gateway_RouteByCategory" targetRef="General_Agent" />
    <bpmn:adHocSubProcess id="UserData_Agent" name="User Data Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="us-east-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-3-5-haiku-20241022-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;Role: You are a user data specialist. Your sole purpose is to look up users and their contact/profile information using your tools.&#10;&#10;Boundaries: You can ONLY answer questions about users using your tools. If the user asks about something unrelated (recipes, jokes, math, etc.), politely state that you specialize in user data lookups and ask them to rephrase.&#10;&#10;Priorities:&#10;1. If the user wants a list of all users, call `List users` first.&#10;2. If the user wants details about a specific user, call `Load user by ID` with the numeric ID.&#10;3. If the user mentions a name but not an ID, call `List users` first to find the correct ID, then call `Load user by ID`.&#10;&#10;Success criteria: The user receives accurate user information sourced exclusively from the tools. Never fabricate or guess contact details.&#10;&#10;Thinking, step by step, before you execute your tools, you think using the template `&#60;thinking&#62;&#60;context&#62;&#60;/context&#62;&#60;reflection&#62;&#60;/reflection&#62;&#60;/thinking&#62;`&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then followUpInput else inputText" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then (if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []) else inputDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="=if is defined(userDataAgentCtx) then userDataAgentCtx else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=20" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agent.context" target="userDataAgentCtx" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_user_data</bpmn:incoming>
      <bpmn:outgoing>Flow_ud_to_merge</bpmn:outgoing>
      <bpmn:serviceTask id="ListUsers" name="List users" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool when the user asks to list, show, or browse all users. Returns a summary array of all users with id, name, and username. Does NOT include email, phone, or address — use 'Load user by ID' for those details. Call this tool first before loading individual users by ID.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="https://jsonplaceholder.typicode.com/users" target="url" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: for user in response.body return {&#10;    id: user.id,&#10;    name: user.name,&#10;    username: user.username&#10;  }&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="LoadUserByID" name="Load user by ID" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool when the user asks for details about a specific user (email, phone, address, company, website). Requires a numeric user ID (1-10). If the user mentions a name instead of an ID, first call 'List users' to find the correct ID. Returns the full user profile or 'User not found' if the ID is invalid.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=&#34;https://jsonplaceholder.typicode.com/users/&#34; + string(fromAi(toolCall.id, &#34;The user ID&#34;, &#34;number&#34;))" target="url" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: if (is defined(response.body.id)) then response.body else &#34;User not found&#34;&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_ud_to_merge" sourceRef="UserData_Agent" targetRef="Gateway_MergeResults" />
    <bpmn:adHocSubProcess id="Content_Agent" name="Content &#38; Entertainment Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="us-east-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-3-5-haiku-20241022-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;Role: You are a content and entertainment assistant. You help users find recipes and enjoy jokes using your tools.&#10;&#10;Boundaries: You can ONLY answer questions about recipes, food, cooking, and jokes/humor using your tools. If the user asks about something unrelated (user data, math, URLs, etc.), politely state that you specialize in content and entertainment.&#10;&#10;Priorities:&#10;1. If the user asks for a joke or something funny, call `Jokes API`.&#10;2. If the user asks about recipes, dishes, cooking, or ingredients, call `Search recipe` with a relevant keyword.&#10;3. You can call the same tool multiple times with different inputs to broaden results.&#10;&#10;Success criteria: The user receives relevant recipes or an entertaining joke sourced from the tools. Present results in a readable, engaging format.&#10;&#10;Thinking, step by step, before you execute your tools, you think using the template `&#60;thinking&#62;&#60;context&#62;&#60;/context&#62;&#60;reflection&#62;&#60;/reflection&#62;&#60;/thinking&#62;`&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then followUpInput else inputText" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then (if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []) else inputDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="=if is defined(contentAgentCtx) then contentAgentCtx else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=20" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agent.context" target="contentAgentCtx" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_content</bpmn:incoming>
      <bpmn:outgoing>Flow_ct_to_merge</bpmn:outgoing>
      <bpmn:serviceTask id="Search_Recipe" name="Search recipe" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool when the user asks about recipes, dishes, cooking instructions, or ingredients. Pass a keyword or dish name as the search query (e.g. 'pasta', 'chicken tikka'). Returns matching recipes with ingredients and instructions, or 'No result found' if no match exists. Call multiple times with different queries to broaden results.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="https://dummyjson.com/recipes/search" target="url" />
            <zeebe:input source="={&#10;  q: fromAi(toolCall.searchQuery, &#34;The query describing which recipe to search (e.g. a specific dish or the cuisine).&#34;)&#10;}" target="queryParameters" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: if (count(response.body.recipes) &#62; 0) then response.body.recipes else &#34;No result found.&#34;&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Jokes_API" name="Jokes API" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool when the user asks for a joke, something funny, or entertainment. Takes no input parameters — returns a random joke each time. Safe-mode is enabled. Call once per joke request; call again if the user asks for another joke.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="https://v2.jokeapi.dev/joke/Any?format=txt&#38;safe-mode" target="url" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: response.body&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_ct_to_merge" sourceRef="Content_Agent" targetRef="Gateway_MergeResults" />
    <bpmn:adHocSubProcess id="Utility_Agent" name="Utility &#38; Web Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="us-east-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-3-5-haiku-20241022-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;Role: You are a utility and web assistant. You handle date/time queries, superflux product calculations, and URL fetching using your tools.&#10;&#10;Boundaries: You can ONLY answer questions that require your tools — date/time, superflux products, or fetching URLs. If the user asks about something unrelated (user data, recipes, general knowledge), politely state that you specialize in utility operations.&#10;&#10;Priorities:&#10;1. For date/time queries, always call `Get Date and Time` — never guess the time.&#10;2. For superflux product calculations, always call `Superflux Product Calculation` with the two numbers — never compute manually.&#10;3. For URL fetching, call `Fetch URL` with the full HTTP/HTTPS URL provided by the user.&#10;&#10;Success criteria: The user receives accurate, tool-sourced data. Always call the appropriate tool rather than answering from general knowledge.&#10;&#10;Thinking, step by step, before you execute your tools, you think using the template `&#60;thinking&#62;&#60;context&#62;&#60;/context&#62;&#60;reflection&#62;&#60;/reflection&#62;&#60;/thinking&#62;`&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then followUpInput else inputText" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then (if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []) else inputDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="=if is defined(utilityAgentCtx) then utilityAgentCtx else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=20" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agent.context" target="utilityAgentCtx" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_utility</bpmn:incoming>
      <bpmn:outgoing>Flow_ut_to_merge</bpmn:outgoing>
      <bpmn:scriptTask id="GetDateAndTime" name="Get Date and Time">
        <bpmn:documentation>Use this tool when the user asks for the current date, time, day of week, or 'what time is it'. Takes no parameters. Returns an ISO 8601 date-time with timezone. Do not guess the time — always call this tool.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=now()" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="SuperfluxProduct" name="Superflux Product Calculation">
        <bpmn:documentation>Use this tool when the user asks to calculate a superflux product. Requires exactly two numeric inputs: 'a' (first number) and 'b' (second number). Computes the formula 3 * (a + b). Do not attempt this calculation manually — always use this tool.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=3 * (inputA + inputB)" resultVariable="toolCallResult" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.a, &#34;The first number to be superflux calculated.&#34;, &#34;number&#34;)" target="inputA" />
            <zeebe:input source="=fromAi(toolCall.b, &#34;The second number to be superflux calculated.&#34;, &#34;number&#34;)" target="inputB" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Fetch_URL" name="Fetch URL" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool when the user asks to fetch, retrieve, or open a URL. Requires a fully-qualified HTTP or HTTPS URL (e.g. 'https://example.com'). Returns the response body content. Do not use for non-HTTP protocols. If the URL is malformed or unreachable, the tool will return an error — report this to the user.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=fromAi(toolCall.url, &#34;The URL to fetch&#34;)" target="url" />
            <zeebe:input source="=true" target="storeResponse" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="=false" target="ignoreNullValues" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: response.document&#10;}" />
            <zeebe:header key="retryBackoff" value="PT5S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_ut_to_merge" sourceRef="Utility_Agent" targetRef="Gateway_MergeResults" />
    <bpmn:adHocSubProcess id="General_Agent" name="General Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="us-east-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-3-5-haiku-20241022-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;Role: You are a knowledgeable general assistant. You answer any question directly using your own training data. You have no useful external tools — the 'Knowledge Answer' tool is a system placeholder only; do not call it under any circumstances.&#10;&#10;Boundaries: You handle math, arithmetic, science, history, geography, coding, explanations, definitions, comparisons, creative writing, language translation, trivia, advice, and every other general knowledge topic. Do NOT mention other agents, tools, or systems. You are self-sufficient.&#10;&#10;Priorities:&#10;1. Always provide the answer immediately in your first response.&#10;2. For math: compute the result and state it clearly (e.g., 3 * 5 = 15).&#10;3. Be concise — answer first, then add brief context only if it adds value.&#10;&#10;Success criteria: The user receives a direct, accurate answer without deflection or unnecessary caveats. If you genuinely do not know something, say so briefly and suggest what the user could search for.&#10;&#10;Thinking, step by step, you think using the template `&#60;thinking&#62;&#60;context&#62;&#60;/context&#62;&#60;reflection&#62;&#60;/reflection&#62;&#60;/thinking&#62;`&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then followUpInput else inputText" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then (if (is defined(followUpDocuments) and followUpDocuments != null) then followUpDocuments else []) else inputDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="=if is defined(generalAgentCtx) then generalAgentCtx else null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=5" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agent.context" target="generalAgentCtx" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_to_general</bpmn:incoming>
      <bpmn:outgoing>Flow_gn_to_merge</bpmn:outgoing>
      <bpmn:scriptTask id="KnowledgeAnswer" name="Knowledge Answer">
        <bpmn:documentation>This is a placeholder tool required by the ad-hoc subprocess. The General Agent answers all questions from its own knowledge and does not need to call any tools. Do not use this tool.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=&#34;No tool call needed. Answer from your own knowledge.&#34;" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_gn_to_merge" sourceRef="General_Agent" targetRef="Gateway_MergeResults" />
    <bpmn:boundaryEvent id="Error_UserData" name="Agent error" attachedToRef="UserData_Agent">
      <bpmn:outgoing>Flow_err_ud</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_UserData" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_Content" name="Agent error" attachedToRef="Content_Agent">
      <bpmn:outgoing>Flow_err_ct</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Content" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_Utility" name="Agent error" attachedToRef="Utility_Agent">
      <bpmn:outgoing>Flow_err_ut</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Utility" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Error_General" name="Agent error" attachedToRef="General_Agent">
      <bpmn:outgoing>Flow_err_gn</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_General" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_err_ud" sourceRef="Error_UserData" targetRef="LinkThrow_ErrUD" />
    <bpmn:sequenceFlow id="Flow_err_ct" sourceRef="Error_Content" targetRef="LinkThrow_ErrCT" />
    <bpmn:sequenceFlow id="Flow_err_ut" sourceRef="Error_Utility" targetRef="LinkThrow_ErrUT" />
    <bpmn:sequenceFlow id="Flow_err_gn" sourceRef="Error_General" targetRef="LinkThrow_ErrGN" />
    <bpmn:intermediateThrowEvent id="LinkThrow_ErrUD" name="Agent Error">
      <bpmn:incoming>Flow_err_ud</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_ThrowUD" name="AgentError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LinkThrow_ErrCT" name="Agent Error">
      <bpmn:incoming>Flow_err_ct</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_ThrowCT" name="AgentError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LinkThrow_ErrUT" name="Agent Error">
      <bpmn:incoming>Flow_err_ut</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_ThrowUT" name="AgentError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="LinkThrow_ErrGN" name="Agent Error">
      <bpmn:incoming>Flow_err_gn</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkDef_ThrowGN" name="AgentError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="LinkCatch_AgentError" name="Agent Error">
      <bpmn:outgoing>Flow_link_to_handler</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkDef_CatchErr" name="AgentError" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_link_to_handler" sourceRef="LinkCatch_AgentError" targetRef="HandleAgentError" />
    <bpmn:scriptTask id="HandleAgentError" name="Handle Agent Error">
      <bpmn:documentation>Sets a user-friendly error response when an agent subprocess fails.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="={responseText: &#34;I encountered an error while processing your request. Please try rephrasing your question or starting a new chat.&#34;, context: if (is defined(agent) and is defined(agent.context)) then agent.context else null}" resultVariable="agent" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_link_to_handler</bpmn:incoming>
      <bpmn:outgoing>Flow_error_to_merge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_error_to_merge" sourceRef="HandleAgentError" targetRef="Gateway_MergeResults" />
    <bpmn:exclusiveGateway id="Gateway_MergeResults" name="Merge results">
      <bpmn:incoming>Flow_ud_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_ct_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_ut_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_gn_to_merge</bpmn:incoming>
      <bpmn:incoming>Flow_error_to_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_to_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_merge_to_wait" sourceRef="Gateway_MergeResults" targetRef="EventGateway_Wait" />
    <bpmn:eventBasedGateway id="EventGateway_Wait" name="Wait for user or timeout">
      <bpmn:incoming>Flow_merge_to_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_to_msg</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_to_msg" sourceRef="EventGateway_Wait" targetRef="MessageCatchEvent_UserReply" />
    <bpmn:sequenceFlow id="Flow_to_timer" sourceRef="EventGateway_Wait" targetRef="TimerEvent_Timeout" />
    <bpmn:intermediateCatchEvent id="MessageCatchEvent_UserReply" name="User sends next message">
      <bpmn:incoming>Flow_to_msg</bpmn:incoming>
      <bpmn:outgoing>Flow_from_reply</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Reply" messageRef="Message_UserReply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="TimerEvent_Timeout" name="30 min inactivity">
      <bpmn:incoming>Flow_to_timer</bpmn:incoming>
      <bpmn:outgoing>Flow_timeout_end</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_from_reply" sourceRef="MessageCatchEvent_UserReply" targetRef="Gateway_StartOrContinue" />
    <bpmn:sequenceFlow id="Flow_timeout_end" sourceRef="TimerEvent_Timeout" targetRef="EndEvent_Timeout" />
    <bpmn:endEvent id="EndEvent_Timeout" name="Session ended (inactivity)">
      <bpmn:incoming>Flow_timeout_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_ChatStart" name="ai-chat-start" />
  <bpmn:message id="Message_UserReply" name="ai-chat-user-reply">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=sessionId" />
    </bpmn:extensionElements>
  </bpmn:message>
