# ─────────────────────────────────────────────────────────────────────────────
#  Frontend .env — checked in with non-secret DEV defaults.
#  See .env.example for the full reference of every supported variable.
#
#  DO NOT paste a real bearer token in this file. Use the in-app auth dialog
#  (the token is held in this browser's localStorage only).
# ─────────────────────────────────────────────────────────────────────────────

# Default modulith preset — overridden in the UI via the env picker dialog.
#   remote-dev   → https://dev-modulith.naitive.ai
#   remote-test  → https://test-modulith.naitive.ai
#   local        → http://localhost:8085 (enables email + OTP flow)
VITE_API_BACKEND=local

# Default visitId for orchestration start (`chatContext.contextData.visitId`).
# Overridden by ?visitId=, the auth dialog (localStorage), or this value.
# Backend resolves visitId to resourceId internally.
VITE_DEFAULT_VISIT_ID=e6175e50-3928-440b-a66b-a3f00366bbf7

# Leave empty — tester pastes the bearer token into the in-app dialog.
# (Vite inlines this into the bundle, so a value here would leak in builds.)
VITE_API_BEARER_TOKEN=

# Auth mode: leave secure (default). Set to `guest` only for public /chatting/* endpoints.
# VITE_CHAT_AUTH=guest

# Console verbosity — `info` is a sane default. Switch to `debug` when diagnosing issues.
VITE_LOG_LEVEL=info

# Pre-fill the LOCAL OTP email field (used only when VITE_API_BACKEND=local).
# VITE_LOCAL_AUTH_EMAIL=tester@code81.com
