# ─────────────────────────────────────────────────────────────────────────────
#  Frontend .env — TEST-focused defaults (non-secrets only).
#  Full reference: .env.example
#
#  Runtime precedence (highest wins):
#    1. UI env picker     → localStorage: ankabut.chat.backendEnv  (DEV | TEST | LOCAL)
#    2. VITE_API_RELATIVE → same-origin /api when no runtime picker (Vite dev proxy)
#    3. VITE_API_ORIGIN   → explicit modulith URL
#    4. VITE_API_BACKEND  → named preset below
#
#  After picking TEST in the auth dialog, OTP calls go directly to test-modulith.naitive.ai.
# ─────────────────────────────────────────────────────────────────────────────

# Default preset before the UI picker is used:
#   remote-test → https://test-modulith.naitive.ai   (email + OTP)
#   remote-dev  → https://dev-modulith.naitive.ai
#   local       → http://localhost:8085
VITE_API_BACKEND=remote-test

# Relative mode: only used before the env picker sets a runtime override.
# After picking TEST, requests use https://test-modulith.naitive.ai directly.
VITE_API_RELATIVE=1

# Optional explicit origin (disables relative mode when set):
# VITE_API_ORIGIN=https://test-modulith.naitive.ai

# Visit UUID for orchestration `chatContext` on POST .../orchestration/.../start.
# Usually auto-loaded after OTP sign-in (my-visits API). Manual fallback:
#   • auth dialog Visit UUID field
#   • ?visitId=<uuid> in the URL
# VITE_DEFAULT_VISIT_ID=

# Optional CI/automation bootstrap only — normal sign-in uses email OTP in the dialog.
VITE_API_BEARER_TOKEN=

# Pre-fill email on the OTP sign-in form.
# VITE_AUTH_EMAIL=you@example.com
# VITE_LOCAL_AUTH_EMAIL=you@example.com

# Console verbosity for `[ankabut-chat:*]` logger.
VITE_LOG_LEVEL=info
