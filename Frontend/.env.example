# ============================================================================
#  Ankabut Chat Frontend — environment variables
# ============================================================================
#  This file documents every Vite env var the SPA understands. Copy to `.env`
#  and edit. The app *also* supports runtime overrides via the in-browser env
#  picker dialog (persisted to localStorage) — those win over anything below.
#
#  Precedence at runtime:
#    1. UI choice from the env picker  (localStorage: ankabut.chat.backendEnv)
#    2. VITE_API_RELATIVE=1            (use Vite /api proxy — see vite.config.js)
#    3. VITE_API_ORIGIN                (explicit URL — wins over any preset)
#    4. VITE_API_BACKEND               (named preset)
#    5. Default: remote-dev
#
#  Anything Vite-exposed is INLINED into the production bundle at build time.
#  Never ship a build that contains a long-lived production bearer.
# ============================================================================


# ── 1. Modulith backend (pick one of three approaches) ──────────────────────

# (A) Named preset — easiest for daily dev. Presets are defined in
#     src/config/apiOrigin.js (`API_BACKENDS`):
#       remote-dev   → https://dev-modulith.naitive.ai
#       remote-test  → https://test-modulith.naitive.ai
#       local        → http://localhost:8085
#     Testers can still flip this in the UI without editing .env.
VITE_API_BACKEND=remote-dev

# (B) Explicit URL — wins over any preset. No trailing slash.
# VITE_API_ORIGIN=https://dev-modulith.naitive.ai

# (C) Same-origin via Vite dev proxy (avoids CORS during dev).
#     The proxy target itself is still controlled by VITE_API_BACKEND / VITE_API_ORIGIN above.
# VITE_API_RELATIVE=1


# ── 2. Chat auth mode ───────────────────────────────────────────────────────
#  `secure` (default) hits `/api/v1/secure/chatting/*` and needs a Bearer token.
#  `guest`            hits `/api/v1/public/chatting/*` with a UUID clientId
#                     (auto-generated; stored in localStorage + optional cookie).
# VITE_CHAT_AUTH=guest


# ── 3. Bearer token for secure mode ─────────────────────────────────────────
#  Three ways to provide one — pick whichever fits:
#    • Paste it into the in-app auth dialog (recommended for testers; per-browser).
#    • Sign in via LOCAL OTP (only available when the backend is localhost:8085).
#    • Set VITE_API_BEARER_TOKEN here — it gets bundled into the build and also
#      copied into localStorage on first load. NOT recommended for prod builds.
VITE_API_BEARER_TOKEN=


# ── 4. Default orchestration resourceId ─────────────────────────────────────
#  Forwarded as `resourceId` on POST .../orchestration/conversations/{id}/start.
#  Backend enforces max length 128 (see ChattingOrchestrationStartRequest).
#  Runtime override: the in-app dialog "Resource ID" field — wins over this.
# VITE_DEFAULT_RESOURCE_ID=e6175e50-3928-440b-a66b-a3f00366bbf7


# ── 5. Misc tuning (all optional) ───────────────────────────────────────────

# Pre-fill the LOCAL OTP email field so testers don't retype it every reload.
# VITE_LOCAL_AUTH_EMAIL=tester@code81.com

# Override guest cookie name — must match modulith `chatting.guest-cookie-name`
# (default ankabut_guest_id). Only relevant when VITE_CHAT_AUTH=guest.
# VITE_GUEST_COOKIE_NAME=ankabut_guest_id

# Console verbosity for the `[ankabut-chat:*]` logger.
# VITE_LOG_LEVEL=debug    # debug | info | warn | error


# ============================================================================
#  Quickstart recipes
# ============================================================================
#  Tester (no .env edits): just `npm install && npm run dev` — pick DEV/TEST in
#  the dialog that appears, paste a bearer token, optionally set a resourceId.
#
#  Local backend with OTP:
#    VITE_API_BACKEND=local
#    (optionally) VITE_LOCAL_AUTH_EMAIL=you@code81.com
#
#  Guest mode against remote-dev (no token needed):
#    VITE_API_BACKEND=remote-dev
#    VITE_CHAT_AUTH=guest
#
#  Dev-time CORS bypass via Vite proxy:
#    VITE_API_RELATIVE=1
#    VITE_API_BACKEND=remote-dev   # proxy target
# ============================================================================
