# ============================================================================
#  Ankabut Chat Frontend — environment variables
# ============================================================================
#  This file documents every Vite env var the SPA understands. Copy to `.env`
#  and edit. The app *also* supports runtime overrides via the in-browser env
#  picker dialog (persisted to localStorage) — those win over anything below.
#
#  Precedence at runtime:
#    1. UI choice from the env picker  (localStorage: ankabut.chat.backendEnv)
#    2. VITE_API_RELATIVE=1            (use Vite /api proxy — see vite.config.js)
#    3. VITE_API_ORIGIN                (explicit URL — wins over any preset)
#    4. VITE_API_BACKEND               (named preset)
#    5. Default: remote-dev
#
#  Anything Vite-exposed is INLINED into the production bundle at build time.
#  Never ship a build that contains a long-lived production bearer.
# ============================================================================


# ── Modulith URL (pick one approach) ─────────────────────────────────────────

# Option A — explicit base URL (wins over preset; no trailing slash):
# VITE_API_ORIGIN=https://dev-modulith.naitive.ai
# VITE_API_ORIGIN=https://test-modulith.naitive.ai
# VITE_API_ORIGIN=https://stg-modulith.naitive.ai
# VITE_API_ORIGIN=http://localhost:8085

# Option B — Vite dev: same-origin `/api/*` + `/v1/internal/*` proxy (see vite.config.js). Empty origin + relative mode:
# VITE_API_RELATIVE=1
# (leave VITE_API_ORIGIN unset)

# Option C — named preset when VITE_API_ORIGIN is unset and VITE_API_RELATIVE is off:
#   remote-dev   → https://dev-modulith.naitive.ai
#   remote-test  → https://test-modulith.naitive.ai
#   remote-stage → https://stg-modulith.naitive.ai
#   local        → http://localhost:8085
#   Testers can still flip this in the UI without editing .env.
VITE_API_BACKEND=remote-dev


# ── Chat auth (JWT secure only) ───────────────────────────────────────────────
#  Public guest chatting (`/api/v1/public/chatting/*`) was removed server-side.
#  Always use JWT on `/api/v1/secure/chatting/*` — sign in via email OTP in the dialog.


# ── Bearer token for secure mode (optional CI/automation bootstrap) ─────────
#  Normal sign-in: email + OTP in the auth dialog (DEV, TEST, and LOCAL).
#  VITE_API_BEARER_TOKEN skips the dialog when pre-set (bundled into build + localStorage on boot).
#  NOT recommended for production builds with real secrets.
VITE_API_BEARER_TOKEN=


# ── Chat context (required for orchestration start) ───────────────────────────
#  VISIT: visit UUID inside chatContext.contextData.id (from my-visits after OTP,
#  or ?visitId=, or VITE_DEFAULT_VISIT_ID).
#  STUDENT: Identity UUID from GET /api/v1/secure/identity/profile/me (data.id).
#  Persona picker appears when both are available. QA: ?persona=STUDENT|VISIT,
#  ?studentId=<uuid> (eligibility only; chat id still from profile/me).
# VITE_DEFAULT_VISIT_ID=<your-visit-uuid>


# ── Misc tuning (all optional) ────────────────────────────────────────────────

# Pre-fill the OTP email field on the sign-in form (DEV, TEST, and LOCAL).
# VITE_AUTH_EMAIL=tester@code81.com
# VITE_LOCAL_AUTH_EMAIL=tester@code81.com

# Console verbosity for the `[ankabut-chat:*]` logger.
# VITE_LOG_LEVEL=debug    # debug | info | warn | error


# ============================================================================
#  Quickstart recipes (DEV / TEST / LOCAL share the same email + OTP flow)
# ============================================================================
#  Tester (no .env edits): `npm install && npm run dev` — pick DEV, TEST, or LOCAL
#  in the dialog, enter email, verify OTP. Visit and/or student context load after sign-in.
#
#  DEV — email + OTP against dev-modulith:
#    VITE_API_BACKEND=remote-dev
#    # VITE_AUTH_EMAIL=you@example.com
#
#  TEST — email + OTP against test-modulith:
#    VITE_API_BACKEND=remote-test
#
#  STAGE — email + OTP against stg-modulith:
#    VITE_API_BACKEND=remote-stage
#
#  LOCAL — email + OTP against modulith on :8085:
#    VITE_API_BACKEND=local
#    VITE_LOCAL_AUTH_EMAIL=you@example.com
#
#  Dev-time CORS bypass via Vite proxy:
#    VITE_API_RELATIVE=1
#    VITE_API_BACKEND=remote-dev
#
#  Important: Vite inlines env vars into the client bundle — do not ship
#  production builds with a real production secret in .env.
# ============================================================================
