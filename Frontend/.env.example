# ── Modulith URL (pick one approach) ─────────────────────────────────
# Preset origins live in src/config/apiOrigin.js (remote-dev, remote-test, local) — use `VITE_API_ORIGIN` to override.

# Option A — explicit base URL (wins over preset; no trailing slash):
# VITE_API_ORIGIN=https://dev-modulith.naitive.ai
# VITE_API_ORIGIN=https://test-modulith.naitive.ai
# VITE_API_ORIGIN=http://localhost:8085

# Option B — Vite dev: same-origin `/api/*` proxy (see vite.config.js). Empty origin + relative mode:
# VITE_API_RELATIVE=1
# (leave VITE_API_ORIGIN unset)

# Option C — named preset when `VITE_API_ORIGIN` is unset and `VITE_API_RELATIVE` is off:
#   remote-dev  → https://dev-modulith.naitive.ai
#   remote-test → https://test-modulith.naitive.ai
#   local       → http://localhost:8085
VITE_API_BACKEND=local

# ── Chat auth mode ────────────────────────────────────────────────────
# `secure` (default): JWT on `/api/v1/secure/chatting/*` — set token below or use local OTP.
# `guest`: `/api/v1/public/chatting/*` + UUID clientId (localStorage + optional cookie ankabut_guest_id).
# VITE_CHAT_AUTH=guest

# Required for secure mode: Bearer for `/api/v1/secure/chatting/*`. Not used when VITE_CHAT_AUTH=guest.
VITE_API_BEARER_TOKEN=

# Optional: override cookie name (must match modulith `chatting.guest-cookie-name`, default ankabut_guest_id)
# VITE_GUEST_COOKIE_NAME=ankabut_guest_id

# Default visitId placed inside the `chatContext` envelope sent on
# POST .../orchestration/conversations/{id}/start.
# Must be a valid UUID. The backend resolves it internally to a resourceId;
# the frontend never sees the resourceId. When unset, a placeholder all-zero
# UUID is used (fine for Phase-1 where the backend ignores the visitId).
# VITE_DEFAULT_VISIT_ID=00000000-0000-0000-0000-000000000000

# Which backend implementation of GET .../conversations/{id}/turns to call:
#   limit (default) — newer endpoint:   ?limit=N   → ApiResponse<ConversationTurnDto[]>      (newest-first)
#   paged           — legacy endpoint:  ?page&size → ApiResponse<PagedResponse<TurnDto>>     (content oldest-first)
# Both shapes are normalized to a newest-first array by the client; switch when the deployed
# modulith version doesn't yet ship the limit-based endpoint.
# VITE_TURNS_API_MODE=limit

# Optional: debug | info | warn | error (`[ankabut-chat:*]` console verbosity)
# VITE_LOG_LEVEL=debug

# ── Setup ─────────────────────────────────────────────────────────────
# Secure + remote: cp .env.example .env → set VITE_API_BEARER_TOKEN → npm install && npm run dev
# Guest + local proxy: VITE_CHAT_AUTH=guest VITE_API_RELATIVE=1 VITE_API_BACKEND=local → npm run dev
#
# Important: Vite inlines env vars into the client bundle — do not ship production builds with a real
# production secret in .env; use a backend-for-frontend or short-lived tokens if users are untrusted.
