# Backend origin (no trailing slash)
# For local development with Docker Compose: modulith service on port 8085
# For production: adjust to your actual backend host/port
VITE_API_ORIGIN=http://localhost:8085

# Optional: catering restaurant/resource id forwarded to Camunda on POST .../orchestration/sessions/{id}/start
# (required by ACL catering create-order flow when the user places an order; must match Spanterk/resource catalog)
# VITE_DEFAULT_CATERING_RESOURCE_ID=e6175e50-3928-440b-a66b-a3f00366bbf7

# Optional: debug | info | warn | error (controls [ankabut-chat:*] console verbosity)
# VITE_LOG_LEVEL=debug

# Guest mode: the demo sets a plain UUID in the ankabut_guest_id cookie. If the modulith enables
# chatting.guest-hmac-secret, the backend expects a signed cookie value — leave the secret unset for
# local demo, or implement signing in the client (see GuestCookieSigner in the modulith).

# ── SETUP INSTRUCTIONS ────────────────────────────────────────────
# 1. Ensure backend services are running (Docker Compose)
# 2. Modulith service contains the chatting API at the origin above
# 3. Copy this file to .env and update VITE_API_ORIGIN if port differs
# 4. Run: npm install && npm run dev
