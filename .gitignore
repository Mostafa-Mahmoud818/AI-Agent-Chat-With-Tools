# Build outputs
Backend/target/
Frontend/node_modules/
Frontend/dist/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
.env.*.local
*.local
!.env.example
!Backend/.env.example
# Frontend .env is checked in: it holds non-secret DEV defaults only.
# Never paste a real bearer token here — use the in-app dialog instead.
!Frontend/.env

# App config (may contain secrets / credentials)
# application.yaml.template IS committed — it contains no real values
Backend/src/main/resources/application.yaml
Backend/src/main/resources/application.yml
Backend/src/main/resources/application-*.yaml
Backend/src/main/resources/application-*.yml
Backend/src/main/resources/application-*.properties
!Backend/src/main/resources/application.yaml.template

